; ===== 新規ゲーム初期化 =====
; ===================================
; 変数一括初期化処理（first.ks / make.ks）
; ===================================

*new_game
[iscript]
  // ----------------------------------
  // 1. 表パラメータ（開示用）
  // ----------------------------------
    if (typeof f.love === "undefined") f.love = 0; // リョーマ好感度
//   f.love = 0; // リョーマ好感度


  // ----------------------------------
  // 2. 裏パラメータ（内部積算用）
  // ----------------------------------
  f.trust = 0; // 周囲信頼度（倫子・南次郎等）
  f.ryoma_dep = 0; // リョーマ依存度
  f.elliott_resp = 0; // 主人公（エリオット）責任度
  f.elliott_obs = 0; // 主人公（エリオット）執着度
  f.ryoma_dec = 0; // リョーマ自己決定度
  f.minus_count = 0; // 冷遇・拒絶選択カウント

  // ----------------------------------
  // 3. 一時判定・イベントフラグ
  // ----------------------------------
  f.choice_continue = false; // DAY9ですがりつきに対し継続希望を選んだか
  f.love_taboo_flag = false; // 好感度で決定的な禁忌肢を選んだか
  f.trust_taboo_flag = false; // 周囲信頼度で決定的な禁忌肢を選んだか
  f.hug_accept = false; // DAY8ハグ/身寄せを受け入れたか
  f.border_crossed = false; // 決定的な一線（境界侵犯）を越えたか
  f.ryoga_flag = false; // リョーガ早期帰還フラグ
  f.ryoga_hint_count = 0; // リョーガ関連の隠しポイントカウント
  f.cat_hint_count = 0; // カルピン関連の隠しポイントカウント
[endscript]

; デバッグ好感度表示開始
[debug_init]


[return]