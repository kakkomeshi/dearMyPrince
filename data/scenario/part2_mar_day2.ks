[_tb_system_call storage=system/_part2_mar_day2.ks]

[cm  ]
[playbgm  volume="100"  time="1000"  loop="true"  storage="rain_03.mp3"  fadein="true"  ]
[bg  time="1000"  method="crossfade"  storage="car_night.png"  ]

; 好感度表示


[debug_init]

[tb_show_message_window  ]
[mask_off  time="1000"  ]
[tb_start_text mode=4 ]
; ----------------------------------------------------
; 第二部 第十一話：3月末『暗闇の選択と、果てなき逃避行』
; ----------------------------------------------------

#
──3月末。[r]
冷たい春雨が静かに降り注ぐ、夕闇の越前家前。[p]

#
エンジンを切ったアウトバックの車内は、息が詰まるほどの沈暮と熱気に支配されていた。[p]

#
周囲からの不信感、彼女からの追及、倫子さんや南次郎さんの冷ややかな視線。[p]
法を学ぶ者としての保身も倫理観も、大人としての良識も、俺の精神の中ではもう限界を迎えていた。[p]

#
このままリョーマを腕の中に抱いていれば、いずれは破滅が待っている。[p]
決して祝福されることもなく、どこにもたどり着けない二人だけの関係。[p]
それでも俺はこの腕の中の少年の温もりも、向けてくれる親愛の何もかもを手放す選択ができなかった。[p]

#
車内での密室関係を怪しんだご両親から、送迎の担当を外すという打診を受けた。[p]
契約を変更し、これからはクラブでの指導のみにとどめ、送り迎えは南次郎さんが引き受けるという。[p]
#
膝の上にちょこんと乗り、俺の服の裾をギュッと握りしめているまだ何も知らないリョーマ。[p]
もう、この日常を維持することはできない。[p]

#エリオット
……リョーマ[p]

#
俺は右の手のひらをリョーマのふっくらとした頬に添える。[p]

#リョーマ
……なに……？[p]

#エリオット
……逃げようか。[r]
……誰も俺たちを知らない、遠いところへ……二人だけで[p]

#
口から突いて出た、狂気を含んだ誘い。[r]
そして、選択肢を子どもに委ねるずるい聞き方。[p]
大人として踏み止まるべき一線を、俺自身の手で完全に破壊した瞬間だった。[p]

; ----------------------------------------------------
; ★演出：画面がホワイトアウトし、心音（SE）とともに視点が切り替わる
; ----------------------------------------------------
[stopbgm time="1000" fadeout="true"]
[mask time="1000" color="0xFFFFFF"]
[wait time="1500"]
; 視点切り替え：エリオット（主人公） ──> 越前リョーマ
[mask_off time="1000"]

#
（……頬に触れたエリオットの手、すごく震えてた）[p]

#
（エリオットは大人で、俺のコーチで、何でも知ってて……。）[p]
（だけど今、俺と同じくらい傷ついて、追い詰められてる）[p]

#
『遠くへ逃げよう』[p]

#
暗闇の中で呟かれたその言葉が、あまい毒みたいに俺の頭の中を満たしていく。[p]
テニスも、親父も、母さんも、学校も……全部捨てて、エリオットと二人きりになれるなら――。[p]

; 【リョーマ視点での運命の選択肢】
[glink color="customized_button" text="……うん。どこへでも、連れてって" target="*choice_escape_yes" width="max"  autopos="true" ]
; [glink color="customized_button" text="……だめだよ。そんなの、逃げだよ" target="*choice_escape_no" width="max"  autopos="true" ]
[s]


*choice_escape_yes
; =========================================================
; ★逃亡決行ルート（※ここから第3部・逃亡編へ突入！）
; =========================================================
[eval exp="f.escape_flag = true"]
[eval exp="sf.escape_route_unlocked = true"]

#
俺は迷わずに、添えられたエリオットの震える大きな手をぎゅっと握り返し、頬を擦り寄せる。[p]

#リョーマ
……うん。どこへでも、連れてって……エリオット[p]

#
エリオットの顔に、安堵と破滅が混ざり合った歪んだ笑みが浮かぶ。[p]

#
もう、家へ戻らなくていい。[p]
ラケットバッグひとつと、エリオットだけいればいい。[p]
俺たちは一度も振り返ることなく、雨の降るハイウェイへと車を走らせた。[p]
; ラケットバッグひとつだけを抱え、俺たちは一度も振り返ることなく、雨の降るハイウェイへと車を走らせた――。[p]

#
; （こうして俺たちの、着の身着のままの逃避行が始まったんだ――）[p]

[stopbgm time="2000" fadeout="true"]
[mask time="2000" color="0x000000"]

; 第三部（逃亡編）開幕画面へジャンプ
[jump storage="part3_escape.ks" target="*start"]


*choice_escape_no
; =========================================================
; ★逃亡拒否ルート（2部内での現実収拾・救済へ）
; =========================================================
[eval exp="f.escape_flag = false"]

#
伸ばされた手を、俺はそっと押し戻した。[p]

#リョーマ
……だめだよ。そんなの、逃げじゃん

#
驚いたように目を見開くアンタ。[r]
アンタのことが好きだからこそ、俺たちの大好きなテニスや世界を全部捨てるわけにはいかない。[p]

#リョーマ
……俺、降りるね。バイバイ……コーチ[p]

#
アンタの手を離し、俺は助手席のドアを開けて冷たい雨の中へと降り立った――。[p]

; 第2部内での現実収拾・記憶封印等へジャンプ
[jump storage="part2_reality_end.ks" target="*start"]

[_tb_end_text]

